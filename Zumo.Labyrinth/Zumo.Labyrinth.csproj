<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <Message Text="Deploying $(ProjectName) to Raspberry Pi..." Importance="high" />
    <Exec Command="bash $(SolutionDir)deploy.sh '$(TargetDir)' '$(ProjectName)'" />
    <Message Text="Deployment complete!" Importance="high" />
  </Target>
  
  <ItemGroup>
    <ProjectReference Include="../Zumo.Library/Zumo.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>
</Project>
